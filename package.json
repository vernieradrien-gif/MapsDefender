{
  "name": "streetdefense",
  "private": true,
  "version": "0.1.0",
  "description": "Tower defense mobile joué sur les rues réelles (OpenStreetMap).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p scripts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "import-map": "tsx scripts/import-osm.ts",
    "simulate": "tsx scripts/simulate.ts",
    "captures": "npm run build && tsx scripts/captures.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0"
  }
}
